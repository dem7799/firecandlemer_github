    "Soft flames help you relax, meditate, and read. A perfect backdrop for evenings and deep focus." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اللهب الناعم يساعدك على الاسترخاء والتأمل والقراءة. خلفية مثالية للأمسيات والتركيز العميق."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bløde flammer hjælper dig med at slappe af, meditere og læse. En perfekt baggrund for aftener og dyb fokus."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sanfte Flammen helfen beim Entspannen, Meditieren, Lesen. Perfekter Hintergrund für Abende und Fokus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soft flames help you relax, meditate, and read. A perfect backdrop for evenings and deep focus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Llamas suaves te ayudan a relajarte, meditar y leer. Fondo perfecto para noches y concentración profunda."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pehmeät liekit auttavat rentoutumaan, meditoimaan ja lukemaan. Täydellinen tausta iltoihin ja syvään keskittymiseen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flammes douces aident à se détendre, méditer et lire. Arrière-plan idéal pour soirées et concentration."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "להבות רכות עוזרות להירגע, למדוט ולקרוא. רקע מושלם לערבים ולמיקוד עמוק."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कोमल लपटें आपको आराम करने, ध्यान करने और पढ़ने में मदद करती हैं। शाम और गहन एकाग्रता के लिए एक आदर्श पृष्ठभूमि।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Api lembut membantu Anda rileks, meditasi, dan membaca. Latar sempurna untuk malam dan fokus mendalam."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fiamme delicate aiutano a rilassarti, meditare e leggere. Sfondo perfetto per serate e profonda concentrazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "柔らかな炎はリラックス、瞑想、読書に役立ちます。夜や深い集中に最適な背景です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "부드러운 불꽃은 휴식, 명상, 독서에 도움을 줍니다. 저녁과 깊은 집중을 위한 완벽한 배경입니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delikatne płomienie pomagają się zrelaksować, medytować i czytać. Idealne tło na wieczory i głębokie skupienie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chamas suaves ajudam a relaxar, meditar e ler. Um cenário perfeito para noites e foco profundo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мягкое пламя помогает расслабиться, медитировать и читать. Идеальный фон для вечеров и глубокого фокуса."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เปลวไฟนุ่มนวลช่วยให้ผ่อนคลาย ทำสมาธิ และอ่านหนังสือ เป็นฉากหลังที่สมบูรณ์แบบสำหรับยามเย็นและการมีสมาธิจดจ่อ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yumuşak alevler rahatlamanıza, meditasyon yapmanıza, okumanıza yardımcı olur. Akşamlar ve derin odaklanma için mükemmel bir arka plan."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lửa dịu nhẹ giúp thư giãn, thiền định và đọc sách. Phông nền hoàn hảo cho buổi tối và tập trung cao độ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "柔和火焰助您放松、冥想、阅读。是夜晚和深度专注的完美背景。"
          }
        }
      }
    },
