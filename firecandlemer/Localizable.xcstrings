    "Forest, water, and wind — authentic sounds for relaxation and sleep. Works offline after download." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "غابة، ماء، ورياح — أصوات طبيعية للاسترخاء والنوم. يعمل بدون إنترنت بعد التحميل."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skov, vand og vind — autentiske lyde for afslapning og søvn. Virker offline efter download."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wald, Wasser, Wind — authentische Klänge für Entspannung & Schlaf. Offline nutzbar nach Download."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forest, water, and wind — authentic sounds for relaxation and sleep. Works offline after download."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bosque, agua y viento: sonidos auténticos para relajación y sueño. Funciona sin conexión tras descarga."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metsä, vesi, tuuli — aidot äänet rentoutumiseen ja uneen. Toimii offline-tilassa latauksen jälkeen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forêt, eau et vent — sons naturels pour détente et sommeil. Fonctionne hors ligne après téléchargement."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יער, מים ורוח — צלילים אותנטיים להרפיה ושינה. עובד במצב לא מקוון לאחר הורדה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जंगल, पानी और हवा — आराम और नींद के लिए प्रामाणिक ध्वनियाँ। डाउनलोड के बाद ऑफ़लाइन काम करता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hutan, air, angin — suara otentik untuk relaksasi dan tidur. Berfungsi offline setelah diunduh."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Foresta, acqua e vento — suoni autentici per relax e sonno. Funziona offline dopo il download."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "森、水、風 — リラックスと睡眠のための本物の音。ダウンロード後オフラインで動作。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "숲, 물, 바람 — 휴식과 수면을 위한 자연의 소리. 다운로드 후 오프라인에서 작동합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las, woda i wiatr — autentyczne dźwięki do relaksu i snu. Działa offline po pobraniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sons autênticos de floresta, água e vento para relaxar e dormir. Funciona offline após download."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Лес, вода и ветер — аутентичные звуки для релакса и сна. Работают офлайн после загрузки."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ป่า น้ำ และลม — เสียงธรรมชาติเพื่อการผ่อนคลายและการนอนหลับ ใช้งานแบบออฟไลน์ได้หลังดาวน์โหลด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orman, su ve rüzgar — rahatlama ve uyku için otantik sesler. İndirildikten sonra çevrimdışı çalışır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rừng, nước, gió — âm thanh chân thực giúp thư giãn và ngủ. Hoạt động ngoại tuyến sau khi tải."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "森林、水、风——放松和睡眠的真实声音。下载后可离线使用。"
          }
        }
      }
    },
