    "Gentle rain eases stress and improves focus. Soothing white noise for sleep and productivity." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المطر اللطيف يخفف التوتر ويحسن التركيز. ضوضاء بيضاء مهدئة للنوم والإنتاجية."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blid regn lindrer stress og forbedrer fokus. Beroligende hvid støj til søvn og produktivitet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sanfter Regen lindert Stress, fördert Fokus. Beruhigendes weißes Rauschen für Schlaf und Produktivität."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gentle rain eases stress and improves focus. Soothing white noise for sleep and productivity."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lluvia suave alivia estrés y mejora concentración. Ruido blanco relajante para sueño y productividad."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lempeä sade lievittää stressiä, parantaa keskittymistä. Rauhoittava valkoinen kohina uneen ja tuottavuuteen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pluie douce réduit stress et améliore concentration. Bruit blanc apaisant pour sommeil et productivité."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "גשם עדין מרגיע לחץ ומשפר מיקוד. רעש לבן מרגיע לשינה ופרודוקטיביות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हल्की बारिश तनाव कम करती है और एकाग्रता बढ़ाती है। नींद और उत्पादकता के लिए सुखदायक सफेद शोर।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hujan lembut meredakan stres, meningkatkan fokus. White noise menenangkan untuk tidur dan produktivitas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pioggia leggera allevia stress e migliora la concentrazione. Rumore bianco rilassante per sonno e produttività."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "やさしい雨はストレスを和らげ集中力を高めます。睡眠と生産性のための心地よいホワイトノイズ。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "부드러운 비는 스트레스 완화, 집중력 향상에 도움. 수면과 생산성을 위한 편안한 백색소음."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delikatny deszcz redukuje stres, poprawia koncentrację. Kojący biały szum do snu i produktywności."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chuva suave alivia estresse e melhora o foco. Ruído branco calmante para sono e produtividade."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нежный дождь снимает стресс и улучшает концентрацию. Успокаивающий белый шум для сна и продуктивности."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ฝนตกปรอยๆ ช่วยลดความเครียดและเพิ่มสมาธิ เสียงสีขาวช่วยผ่อนคลายเพื่อนอนหลับและเพิ่มประสิทธิภาพ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hafif yağmur stresi azaltır, odaklanmayı artırır. Uyku ve verimlilik için yatıştırıcı beyaz gürültü."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mưa nhẹ giảm căng thẳng, tăng tập trung. Tiếng ồn trắng êm dịu cho giấc ngủ và năng suất."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "细雨缓解压力，提升专注力。舒缓的白噪音助眠增效。"
          }
        }
      }
    },
