    "Calming water and fish movement soothe and set the mood — great for rest and meditation." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الماء الهادئ وحركة الأسماك تهدئ وتخلق أجواءً رائعة للراحة والتأمل."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beroligende vand og fiskebevægelse lindrer og skaber stemning — fantastisk til hvile og meditation."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruhiges Wasser und Fischbewegung beruhigen und schaffen Stimmung – ideal für Ruhe und Meditation."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calming water and fish movement soothe and set the mood — great for rest and meditation."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agua tranquila y peces calman, crean ambiente ideal para descanso y meditación."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rauhoittava vesi ja kalojen liike tyynnyttävät ja luovat tunnelmaa — sopii lepoon ja meditaatioon."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'eau et les poissons apaisants créent une ambiance parfaite pour le repos et la méditation."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מים רגועים ותנועת דגים מרגיעים ויוצרים אווירה — נהדר למנוחה ומדיטציה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "शांत पानी और मछली की हलचल मन को शांत करती है, आराम और ध्यान के लिए उत्तम।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Air tenang dan gerakan ikan menenangkan suasana, cocok untuk istirahat dan meditasi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acqua e pesci calmi rilassano e creano l'atmosfera ideale per riposo e meditazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "穏やかな水と魚の動きは気分を落ち着かせ、休息や瞑想に最適です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "잔잔한 물과 물고기 움직임은 평온함을 주어 휴식과 명상에 좋습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spokojna woda i ruch ryb koją i tworzą nastrój — idealne do odpoczynku i medytacji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Água calma e movimento dos peixes acalmam e criam um ambiente ideal para descanso e meditação."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Успокаивающая вода и движения рыб создают настроение — отлично для отдыха и медитации."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "น้ำที่สงบและการเคลื่อนไหวของปลาช่วยผ่อนคลาย สร้างอารมณ์ดี — เหมาะสำหรับการพักผ่อนและทำสมาธิ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sakin su ve balık hareketleri rahatlatır, dinlenme ve meditasyon için harika bir atmosfer yaratır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nước êm đềm và cá bơi nhẹ nhàng làm dịu tâm trạng, tuyệt vời cho thư giãn và thiền định."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "平静的水和鱼的游动能舒缓心情，营造休息和冥想的绝佳氛围。"
          }
        }
      }
    },
