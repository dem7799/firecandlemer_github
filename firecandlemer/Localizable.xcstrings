    "Steady white noise masks distractions for deeper sleep and focus — perfect for study, work, and bedtime." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ضوضاء بيضاء ثابتة تخفي المشتتات لنوم وتركيز أعمق — مثالية للدراسة والعمل ووقت النوم."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jævn hvid støj maskerer distraktioner for dybere søvn og fokus — perfekt til studie, arbejde og sengetid."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stetiges weißes Rauschen überdeckt Ablenkungen für tieferen Schlaf und Fokus – ideal für Studium, Arbeit, Schlafenszeit."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steady white noise masks distractions for deeper sleep and focus — perfect for study, work, and bedtime."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruido blanco constante oculta distracciones para sueño y concentración profundos — ideal para estudio, trabajo y dormir."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tasainen valkoinen kohina peittää häiriöt syvempään uneen ja keskittymiseen – täydellinen opiskeluun, työhön ja nukkumaanmenoaikaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruit blanc constant masque distractions pour sommeil et concentration profonds — idéal étude, travail, coucher."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "רעש לבן קבוע מסווה הסחות דעת לשינה עמוקה ומיקוד — מושלם ללימודים, עבודה ולפני השינה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्थिर सफेद शोर गहरे नींद और एकाग्रता के लिए विकर्षणों को छिपाता है — अध्ययन, काम और सोने के लिए बिल्कुल सही।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "White noise stabil menyamarkan gangguan untuk tidur dan fokus lebih dalam — sempurna untuk belajar, bekerja, dan waktu tidur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rumore bianco costante maschera distrazioni per sonno e focus più profondi — perfetto per studio, lavoro e nanna."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "安定したホワイトノイズは、深い睡眠と集中を妨げるものを隠します — 勉強、仕事、就寝時に最適です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일정한 백색소음은 방해 요소를 가려 깊은 수면과 집중을 돕습니다 — 공부, 업무, 취침에 완벽합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stały biały szum maskuje rozpraszacze dla głębszego snu i skupienia — idealny do nauki, pracy i przed snem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruído branco constante mascara distrações para sono e foco mais profundos — perfeito para estudo, trabalho e hora de dormir."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ровный белый шум маскирует отвлекающие звуки и помогает глубже спать и сосредотачиваться — идеален для учёбы, работы и отхода ко сну."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เสียงสีขาวคงที่ช่วยบดบังสิ่งรบกวน เพื่อการนอนหลับและสมาธิที่ลึกซึ้งยิ่งขึ้น — เหมาะสำหรับการเรียน ทำงาน และก่อนนอน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sürekli beyaz gürültü dikkat dağıtıcıları maskeleyerek daha derin uyku ve odaklanma sağlar — çalışma, iş ve uyku vakti için mükemmel."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiếng ồn trắng ổn định che giấu phiền nhiễu, giúp ngủ sâu và tập trung — hoàn hảo cho học tập, làm việc và giờ ngủ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "稳定的白噪音屏蔽干扰，助您深度睡眠和专注 — 学习、工作和睡前绝佳。"
          }
        }
      }
    },
