    "Unwind, sleep, or work with a real fireplace ambience. Seamlessly looping videos and natural sound create instant coziness." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استرخِ، نم، أو اعمل مع أجواء مدفأة حقيقية. مقاطع فيديو متكررة بسلاسة وصوت طبيعي يخلقان دفئًا فوريًا."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slap af, sov eller arbejd med ægte pejsestemning. Sømløse looping-videoer og naturlig lyd skaber øjeblikkelig hygge."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entspannen, schlafen oder arbeiten mit echter Kamin-Atmosphäre. Nahtlose Videos und Naturklang schaffen sofortige Gemütlichkeit."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unwind, sleep, or work with a real fireplace ambience. Seamlessly looping videos and natural sound create instant coziness."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relájate, duerme o trabaja con ambiente de chimenea real. Vídeos en bucle y sonido natural crean calidez instantánea."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rentoudu, nuku tai työskentele aidon takkatunnelman äärellä. Saumattomasti toistuvat videot ja luonnollinen ääni luovat välittömän kodikkuuden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Détendez-vous, dormez ou travaillez avec l'ambiance d'une vraie cheminée. Boucles vidéo et son naturel créent un confort instantané."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הירגע, ישן או עבוד עם אווירת אח אמיתית. סרטונים בלולאה חלקה וצליל טבעי יוצרים נעימות מיידית."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक वास्तविक चिमनी के माहौल में आराम करें, सोएं या काम करें। निर्बाध लूपिंग वीडियो और प्राकृतिक ध्वनि तत्काल आराम पैदा करते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bersantai, tidur, atau bekerja dengan suasana perapian asli. Video berulang mulus dan suara alami menciptakan kenyamanan instan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rilassati, dormi o lavora con l'ambiente di un vero camino. Video in loop e suoni naturali creano calore istantaneo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本物の暖炉の雰囲気でくつろぎ、眠り、または作業を。シームレスなループビデオと自然な音は、瞬時に居心地の良さを生み出します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "실제 벽난로 분위기로 휴식, 수면 또는 업무를. 끊김 없는 반복 영상과 자연스러운 소리가 즉각적인 아늑함을 선사합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odpręż się, śpij lub pracuj z prawdziwą atmosferą kominka. Płynnie zapętlone filmy i naturalny dźwięk tworzą natychmiastowy nastrój."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relaxe, durma ou trabalhe com uma atmosfera de lareira real. Vídeos em loop contínuo e som natural criam aconchego instantâneo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Расслабьтесь, спите или работайте с настоящей атмосферой камина. Бесшовные зацикленные видео и естественный звук создают мгновенный уют."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ผ่อนคลาย นอนหลับ หรือทำงานด้วยบรรยากาศเตาผิงจริง วิดีโอวนซ้ำอย่างต่อเนื่องและเสียงธรรมชาติสร้างความอบอุ่นทันที"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gerçek şömine ambiyansı ile rahatlayın, uyuyun veya çalışın. Kesintisiz döngü videolar ve doğal ses anında rahatlık yaratır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thư giãn, ngủ hoặc làm việc với không khí lò sưởi thật. Video lặp lại mượt mà và âm thanh tự nhiên tạo sự ấm cúng tức thì."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在真实壁炉氛围中放松、入眠或工作。无缝循环视频和自然音效瞬间营造温馨。"
          }
        }
      }
    },
