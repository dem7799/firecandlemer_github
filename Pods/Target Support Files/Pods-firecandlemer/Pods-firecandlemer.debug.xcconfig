ALWAYS_EMBED_SWIFT_STANDARD_LIBRARIES = YES
CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER = NO
FRAMEWORK_SEARCH_PATHS = $(inherited) "${PODS_CONFIGURATION_BUILD_DIR}/RevenueCat" "${PODS_CONFIGURATION_BUILD_DIR}/RevenueCatUI" "${PODS_ROOT}/AppsFlyerFramework/binaries/xcframework/full" "${PODS_ROOT}/OneSignal/iOS_SDK/OneSignalSDK/OneSignal_Core" "${PODS_ROOT}/OneSignal/iOS_SDK/OneSignalSDK/OneSignal_Extension" "${PODS_ROOT}/OneSignal/iOS_SDK/OneSignalSDK/OneSignal_LiveActivities" "${PODS_ROOT}/OneSignal/iOS_SDK/OneSignalSDK/OneSignal_Notifications" "${PODS_ROOT}/OneSignal/iOS_SDK/OneSignalSDK/OneSignal_OSCore" "${PODS_ROOT}/OneSignal/iOS_SDK/OneSignalSDK/OneSignal_Outcomes" "${PODS_ROOT}/OneSignal/iOS_SDK/OneSignalSDK/OneSignal_User" "${PODS_ROOT}/OneSignal/iOS_SDK/OneSignalSDK/OneSignal_XCFramework" "${PODS_XCFRAMEWORKS_BUILD_DIR}/AppsFlyerFramework/Main" "${PODS_XCFRAMEWORKS_BUILD_DIR}/OneSignal/OneSignal" "${PODS_XCFRAMEWORKS_BUILD_DIR}/OneSignal/OneSignalCore" "${PODS_XCFRAMEWORKS_BUILD_DIR}/OneSignal/OneSignalExtension" "${PODS_XCFRAMEWORKS_BUILD_DIR}/OneSignal/OneSignalLiveActivities" "${PODS_XCFRAMEWORKS_BUILD_DIR}/OneSignal/OneSignalNotifications" "${PODS_XCFRAMEWORKS_BUILD_DIR}/OneSignal/OneSignalOSCore" "${PODS_XCFRAMEWORKS_BUILD_DIR}/OneSignal/OneSignalOutcomes" "${PODS_XCFRAMEWORKS_BUILD_DIR}/OneSignal/OneSignalUser"
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) COCOAPODS=1
HEADER_SEARCH_PATHS = $(inherited) "${PODS_CONFIGURATION_BUILD_DIR}/RevenueCat/RevenueCat.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/RevenueCatUI/RevenueCatUI.framework/Headers"
LD_RUNPATH_SEARCH_PATHS = $(inherited) /usr/lib/swift '@executable_path/Frameworks' '@loader_path/Frameworks'
LIBRARY_SEARCH_PATHS = $(inherited) "${TOOLCHAIN_DIR}/usr/lib/swift/${PLATFORM_NAME}" /usr/lib/swift
OTHER_LDFLAGS = $(inherited) -ObjC -framework "AppsFlyerLib" -framework "CoreTelephony" -framework "OneSignalCore" -framework "OneSignalExtension" -framework "OneSignalFramework" -framework "OneSignalLiveActivities" -framework "OneSignalNotifications" -framework "OneSignalOSCore" -framework "OneSignalOutcomes" -framework "OneSignalUser" -framework "RevenueCat" -framework "RevenueCatUI" -framework "Security" -framework "StoreKit" -framework "SwiftUI" -framework "SystemConfiguration"
OTHER_MODULE_VERIFIER_FLAGS = $(inherited) "-F${PODS_CONFIGURATION_BUILD_DIR}/AppsFlyerFramework" "-F${PODS_CONFIGURATION_BUILD_DIR}/OneSignal" "-F${PODS_CONFIGURATION_BUILD_DIR}/RevenueCat" "-F${PODS_CONFIGURATION_BUILD_DIR}/RevenueCatUI"
OTHER_SWIFT_FLAGS = $(inherited) -D COCOAPODS
PODS_BUILD_DIR = ${BUILD_DIR}
PODS_CONFIGURATION_BUILD_DIR = ${PODS_BUILD_DIR}/$(CONFIGURATION)$(EFFECTIVE_PLATFORM_NAME)
PODS_PODFILE_DIR_PATH = ${SRCROOT}/.
PODS_ROOT = ${SRCROOT}/Pods
PODS_XCFRAMEWORKS_BUILD_DIR = $(PODS_CONFIGURATION_BUILD_DIR)/XCFrameworkIntermediates
USE_RECURSIVE_SCRIPT_INPUTS_IN_SCRIPT_PHASES = YES
